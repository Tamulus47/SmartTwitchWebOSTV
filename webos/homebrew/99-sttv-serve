#!/bin/sh
# SmartTwitchWebOSTV local HLS remux server (tools/tv-serve.js).
# Transmuxes Twitch fMP4 -> MPEG-TS for the platform player; webOS 3.4
# (Chrome 38) cannot decode fMP4 in any other path. See docs/CHROME38.md.
# Installed at /var/lib/webosbrew/init.d/99-sttv-serve (runs as root on
# every boot via startup.sh, which the wrapper app kicks at launch and the
# com.tbsniller.smarttwitchwebostv.boot activity kicks at boot).
if ! pgrep -f 'stt[v]_serve' >/dev/null 2>&1; then
    cd /media/developer/sttv_stage || exit 0
    nohup node sttv_serve.js 8099 >/dev/null 2>&1 &
fi
exit 0
